<%- include('../partials/shell') %>
<div class="grid lg:grid-cols-5 gap-4">
  <div class="lg:col-span-3">
    <%- include('../partials/receipt-form', { submitLabel: 'Enregistrer le paiement', cancelHref: '/paiements' }) %>
  </div>
  <div class="lg:col-span-2">
    <div class="card p-5">
      <h3 class="font-semibold mb-2">Suivi des loyers</h3>
      <p class="text-sm text-ink-700 leading-relaxed">Le statut d'un mois repose sur les paiements réellement enregistrés, jamais sur la simple
        existence d'une quittance, et jamais automatiquement au changement de mois.</p>
      <p class="text-sm text-ink-700 leading-relaxed mt-3">Un paiement partiel génère un reçu clairement identifié comme partiel, avec le solde restant.
        Le versement suivant complète la période jusqu'à la quittance définitive.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <a href="/calendrier" class="btn btn-ghost"><i data-lucide="calendar-days" class="w-4 h-4"></i> Suivi mensuel</a>
        <a href="/paiements" class="btn btn-ghost"><i data-lucide="list" class="w-4 h-4"></i> Tous les paiements</a>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
