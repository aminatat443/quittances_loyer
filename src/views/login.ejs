<%- include('partials/head') %>
<div class="min-h-screen grid place-items-center px-4 py-10">
  <div class="w-full max-w-sm">
    <div class="text-center mb-6">
      <span class="inline-grid place-items-center w-12 h-12 rounded-xl bg-brand-600 text-white mb-3">
        <i data-lucide="home" class="w-6 h-6"></i>
      </span>
      <h1 class="text-xl font-semibold tracking-tight"><%= app.name %></h1>
      <p class="text-sm text-ink-500 mt-1"><%= app.owner %> · gestion des loyers</p>
    </div>
    <div class="card p-6">
      <% if (typeof error !== 'undefined' && error) { %>
        <p class="mb-4 text-sm rounded-lg bg-red-50 border border-red-100 text-red-700 px-3 py-2"><%= error %></p>
      <% } %>
      <form method="post" action="/login" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div>
          <label class="field-label" for="username">Identifiant</label>
          <input class="field-input" id="username" name="username" autocomplete="username" required>
        </div>
        <div>
          <label class="field-label" for="password">Mot de passe</label>
          <input class="field-input" id="password" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-primary w-full justify-center">Se connecter</button>
      </form>
      <p class="mt-4 text-xs text-ink-500 leading-relaxed">
        Usage privé de gestion locative. Le mot de passe initial se configure dans le fichier <code>.env</code>.
      </p>
    </div>
  </div>
</div>
<script src="/static/vendor/lucide.min.js"></script>
<script>lucide.createIcons();</script>
<script src="/static/js/pwa.js"></script>
</body>
</html>
