<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= app.name %></title>
  <script src="/static/vendor/tailwind.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { 50:'#eef6f1', 100:'#d6e9dd', 300:'#7fb393', 500:'#2f7a52', 600:'#256343', 700:'#1c4c34', 900:'#0f2c1f' },
            ink: { 500:'#6b7280', 700:'#3f4650', 900:'#23272a' },
            paper: '#f7f7f5',
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'Segoe UI', 'Roboto', 'sans-serif'] },
          boxShadow: { card: '0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.08)' },
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="stylesheet" href="/static/css/print.css">
  <%- include('pwa-head') %>
</head>
<body class="bg-paper text-ink-900 font-sans antialiased">
