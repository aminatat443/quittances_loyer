# Port du serveur
PORT=3000

# Base de données (chemin relatif ou absolu)
DATABASE_PATH=./data/rent.sqlite

# Compte administrateur créé au premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-2026

# Secret de session (à changer en production)
SESSION_SECRET=remplacez-ce-secret-par-une-chaine-aleatoire-longue

# Sauvegardes automatiques (dossier)
BACKUP_DIR=./data/backups

# ---------- Envoi réel des documents par e-mail (SMTP) ----------
# Sans ces valeurs, l'application ne prétend jamais avoir envoyé un message :
# elle propose un brouillon mailto et enregistre l'action comme « préparé ».
# Ces identifiants restent côté serveur ; ils ne sont ni affichés, ni commités.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Test hors ligne : construit le message sans le remettre à un serveur (= 1).
# L'envoi est alors journalisé « préparé », jamais « envoyé ».
SMTP_JSON_TRANSPORT=

# ---------- Téléchargement PDF ----------
# Moteur : chromium (CLI headless) ou none (désactive le téléchargement PDF).
PDF_ENGINE=chromium
# Binaire à utiliser si l'auto-détection échoue (Chrome, Chromium, chromium-browser…).
CHROME_PATH=

# ---------- Automatisation WhatsApp (API officielle, optionnelle) ----------
# Réservée à un compte WhatsApp Business approuvé par Meta. Sans ces valeurs,
# l'application ouvre uniquement un brouillon wa.me prérempli.
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
